// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  expires_at          DateTime?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("accounts")
}

model User {
  id                String    @id @default(cuid())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())
  deleted_at        DateTime?
  approved_at       DateTime?
  email_verified_at DateTime?

  status         Int?    @default(1) @db.SmallInt // 1 = active, 0 = pending, -1 = blocked, -2 = deactivated
  email          String? @unique
  phone_number   String? @unique
  username       String? @unique
  name           String? @db.VarChar(255)
  password       String? @db.VarChar(255)
  avatar         String?
  free_wait_time Int?    @default(0)
  rate_per_hour  Int?    @default(0)
  type           String? @default("user")

  // billing id. e.g. stripe customer id
  billing_id String?

  accounts               Account[]
  receiver_notifications Notification[] @relation("receiver")
  sender_notifications   Notification[] @relation("sender")

  user_payment_methods UserPaymentMethod[]
  user_settings        UserSetting[]
  ucodes               Ucode[]
  roles                Role[]
  role_users           RoleUser[]
  payment_transactions PaymentTransaction[]
  stop_logs            StopLog[]
  claims               Claim[]

  @@index([status])
  @@index([created_at])
  @@map("users")
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token      String?
  email      String?
  expired_at DateTime?

  @@index([user_id])
  @@index([token])
  @@map("ucodes")
}

model Role {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  title  String?
  name   String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  permission_roles PermissionRole[]
  role_users       RoleUser[]
  permissions      Permission[]     @relation("PermissionToRole")

  @@index([user_id])
  @@map("roles")
}

model Permission {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  title      String?
  action     String?
  subject    String?
  conditions String?
  fields     String?

  permission_roles PermissionRole[]
  roles            Role[]           @relation("PermissionToRole")

  @@map("permissions")
}

model PermissionRole {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@index([permission_id])
  @@index([role_id])
  @@map("permission_roles")
}

model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@index([role_id])
  @@index([user_id])
  @@map("role_users")
}

// this table stores notification event
model NotificationEvent {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  type   String?
  text   String?

  notifications Notification[]

  @@map("notification_events")
}

model Notification {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  read_at DateTime?

  status Int? @default(1) @db.SmallInt

  sender_id String?
  sender    User?   @relation("sender", fields: [sender_id], references: [id], onDelete: SetNull)

  receiver_id String?
  receiver    User?   @relation("receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  notification_event_id String?
  notification_event    NotificationEvent? @relation(fields: [notification_event_id], references: [id], onDelete: SetNull)

  entity_id String?

  @@index([sender_id])
  @@index([receiver_id])
  @@index([notification_event_id])
  @@index([created_at])
  @@map("notifications")
}

model UserPaymentMethod {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  payment_method_id String?
  checkout_id       String?

  @@index([user_id])
  @@map("user_payment_methods")
}

model PaymentTransaction {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  store_id String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  order_id         String?
  type             String?  @default("order")
  withdraw_via     String?  @default("wallet")
  provider         String?
  reference_number String?
  status           String?  @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("payment_transactions")
}

model Contact {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  first_name   String?
  last_name    String?
  email        String?
  phone_number String?
  message      String?

  @@index([created_at])
  @@map("contacts")
}

model Setting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  category      String?
  label         String?
  description   String?
  key           String? @unique
  default_value String?

  user_settings UserSetting[]

  @@index([category])
  @@map("settings")
}

model UserSetting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  setting_id String?
  setting    Setting? @relation(fields: [setting_id], references: [id], onDelete: Cascade)

  value String?

  @@index([user_id])
  @@index([setting_id])
  @@map("user_settings")
}

enum StopLogStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CLAIM_DRAFTED
  CLAIM_SUBMITTED
  CANCELLED
}

enum DetentionRateConfirmed {
  YES
  NO
  NOT_SURE
}

model StopLog {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  arrival_location_id String? @unique
  facility_address_id String? @unique

  user_id    String?
  shipper_id String?

  // snapshots for evidence of stop logs
  facility_name        String
  load_number          String?
  bol_number           String?
  shipper_name         String?
  broker_name          String?
  broker_email         String?
  broker_mc_number     String?
  free_time_minutes    Int     @default(120)
  detention_rate_pence Int     @default(0)

  arrived_at   DateTime
  docked_at    DateTime?
  completed_at DateTime?
  departed_at  DateTime?

  notice_sent_at               DateTime?
  notice_method                String? // email, phone_number
  rate_con_detention_confirmed DetentionRateConfirmed?

  status      StopLogStatus @default(DRAFT)
  attachments Attachment[]

  // relations
  claim            Claim?
  user             User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shipper          Shipper?  @relation(fields: [shipper_id], references: [id], onDelete: Cascade)
  arrival_location Location? @relation("arrival_location", fields: [arrival_location_id], references: [id])
  facility_address Location? @relation("facility_address", fields: [facility_address_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@index([shipper_id])
  @@map("stop_logs")
}

enum AttachmentType {
  BOL
  RATE_CONFIRMATION
  ELD_SCREENSHOT
  FACILITY_STAMP_PHOTO
  PROOF_PACKAGE
  DEMAND_LETTER
  BOND_CLAIM_PACKET
  COURT_FILING_PACKET
  COMPLETE_CASE_FILE
  OTHER
}

model Attachment {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  stop_log_id String?
  claim_id    String?

  type AttachmentType

  file_url   String
  file_name  String?
  mime_type  String?
  size_bytes Int?

  claim    Claim?   @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  stop_log StopLog? @relation(fields: [stop_log_id], references: [id], onDelete: Cascade)

  @@index([stop_log_id])
  @@index([claim_id])
  @@index([type])
  @@map("attachments")
}

model Shipper {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name            String
  normalized_name String @unique

  stop_logs StopLog[]
  claims    Claim[]

  @@map("shippers")
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  FOLLOW_UP
  IN_RECOURSE
  PAID
  DENIED
  UNCOLLECTABLE
  IN_COLLECTIONS
}

enum ClaimSendMethod {
  EMAIL
  SMS
  SHARE
}

enum ClaimEventType {
  CLAIM_SENT
  FOLLOW_UP_SENT
  BROKER_ESCALATION_SENT
  DEMAND_LETTER_MAILED
  BOND_CLAIM_FILED
  CREDIT_REPORT_SUBMITTED
  FMCSA_COMPLAINT_FILED
  LOAD_BOARD_REVIEW_POSTED
  SMALL_CLAIMS_FILED
  COLLECTIONS_REFERRED
  ATTORNEY_REFERRED
  MARKED_PAID
  MARKED_DENIED
  MARKED_UNCOLLECTABLE
}

model Claim {
  // --- Meta & Timestamps ---
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Core Info ---
  status ClaimStatus @default(DRAFT)

  // --- Financials ---
  claim_amount Int
  paid_amount  Int?

  // --- Lifecycle Events ---
  sent_at                 DateTime?
  paid_at                 DateTime?
  denied_at               DateTime?
  recourse_started_at     DateTime?
  collections_referred_at DateTime?

  // --- Denial Details ---
  denied_by     String?
  denial_reason String?

  // --- Communication ---
  recipient_email String?
  send_method     String  @default("EMAIL") // EMAIL, SMS, SHARE

  // --- Follow-up Management ---
  followup_due_at   DateTime?
  last_follow_up_at DateTime?
  followup_count    Int       @default(0)

  // --- Proof Package ---
  proof_package_generated_at DateTime?
  proof_package_url          String?
  proof_package_version      Int       @default(1)

  // --- Recourse & Legal ---
  recourse_level           Int     @default(0)
  usps_tracking_number     String?
  fmcsa_complaint_number   String?
  small_claims_case_number String?

  // --- Foreign Keys ---
  user_id     String
  shipper_id  String
  stop_log_id String @unique

  // --- Relations ---
  shipper     Shipper      @relation(fields: [shipper_id], references: [id])
  user        User         @relation(fields: [user_id], references: [id])
  stop_log    StopLog      @relation(fields: [stop_log_id], references: [id])
  attachments Attachment[]

  @@map("claims")
}

model Location {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  city    String?
  state   String?
  country String?
  address String?
  zip     String?
  lat     Decimal?
  lng     Decimal?

  arrival_locations  StopLog[] @relation("arrival_location")
  facility_addresses StopLog[] @relation("facility_address")

  @@map("locations")
}
